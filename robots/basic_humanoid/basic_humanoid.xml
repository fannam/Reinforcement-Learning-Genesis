<mujoco model="basic_humanoid">
  <compiler angle="radian" inertiafromgeom="true" autolimits="true"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <joint damping="1.0" armature="0.02" limited="true"/>
    <geom density="650" friction="1.0 0.1 0.1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <asset>
    <material name="body_mat" rgba="0.18 0.42 0.78 1"/>
    <material name="joint_mat" rgba="0.94 0.70 0.24 1"/>
    <material name="foot_mat" rgba="0.10 0.12 0.14 1"/>
    <material name="floor_mat" rgba="0.82 0.84 0.86 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="1 -3 4" dir="-0.2 0.6 -1" diffuse="0.8 0.8 0.8"/>
    <camera name="front" pos="2.2 -3.0 1.4" xyaxes="0.80 0.60 0 -0.24 0.32 0.92"/>
    <geom name="floor" type="plane" size="4 4 0.05" material="floor_mat"/>

    <body name="pelvis" pos="0 0 1.05">
      <freejoint name="root"/>
      <geom name="pelvis_geom" type="capsule" fromto="-0.13 0 0 0.13 0 0" size="0.08" material="body_mat"/>

      <body name="torso" pos="0 0 0.12">
        <joint name="abdomen_y" type="hinge" axis="0 1 0" range="-0.45 0.45"/>
        <geom name="torso_geom" type="capsule" fromto="0 0 0 0 0 0.42" size="0.11" material="body_mat"/>

        <body name="head" pos="0 0 0.57">
          <geom name="head_geom" type="sphere" size="0.11" material="joint_mat"/>
        </body>

        <body name="right_upper_arm" pos="0 -0.18 0.34">
          <joint name="shoulder_right" type="hinge" axis="0 1 0" range="-1.7 1.1"/>
          <geom name="right_shoulder_geom" type="sphere" size="0.055" material="joint_mat"/>
          <geom name="right_upper_arm_geom" type="capsule" fromto="0 0 0 0 -0.26 0" size="0.04" material="body_mat"/>

          <body name="right_forearm" pos="0 -0.26 0">
            <joint name="elbow_right" type="hinge" axis="0 1 0" range="-1.7 0.1"/>
            <geom name="right_elbow_geom" type="sphere" size="0.048" material="joint_mat"/>
            <geom name="right_forearm_geom" type="capsule" fromto="0 0 0 0 -0.24 0" size="0.035" material="body_mat"/>
          </body>
        </body>

        <body name="left_upper_arm" pos="0 0.18 0.34">
          <joint name="shoulder_left" type="hinge" axis="0 1 0" range="-1.7 1.1"/>
          <geom name="left_shoulder_geom" type="sphere" size="0.055" material="joint_mat"/>
          <geom name="left_upper_arm_geom" type="capsule" fromto="0 0 0 0 0.26 0" size="0.04" material="body_mat"/>

          <body name="left_forearm" pos="0 0.26 0">
            <joint name="elbow_left" type="hinge" axis="0 1 0" range="-1.7 0.1"/>
            <geom name="left_elbow_geom" type="sphere" size="0.048" material="joint_mat"/>
            <geom name="left_forearm_geom" type="capsule" fromto="0 0 0 0 0.24 0" size="0.035" material="body_mat"/>
          </body>
        </body>
      </body>

      <body name="right_thigh" pos="0 -0.08 -0.03">
        <joint name="hip_right" type="hinge" axis="0 1 0" range="-1.2 1.0"/>
        <geom name="right_hip_geom" type="sphere" size="0.06" material="joint_mat"/>
        <geom name="right_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.055" material="body_mat"/>

        <body name="right_shin" pos="0 0 -0.42">
          <joint name="knee_right" type="hinge" axis="0 1 0" range="-1.8 0.05"/>
          <geom name="right_knee_geom" type="sphere" size="0.052" material="joint_mat"/>
          <geom name="right_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.40" size="0.045" material="body_mat"/>

          <body name="right_foot" pos="0 0 -0.40">
            <joint name="ankle_right" type="hinge" axis="0 1 0" range="-0.7 0.7"/>
            <geom name="right_ankle_geom" type="sphere" size="0.045" material="joint_mat"/>
            <geom name="right_foot_geom" type="box" pos="0.08 0 -0.035" size="0.16 0.06 0.035" material="foot_mat"/>
          </body>
        </body>
      </body>

      <body name="left_thigh" pos="0 0.08 -0.03">
        <joint name="hip_left" type="hinge" axis="0 1 0" range="-1.2 1.0"/>
        <geom name="left_hip_geom" type="sphere" size="0.06" material="joint_mat"/>
        <geom name="left_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.055" material="body_mat"/>

        <body name="left_shin" pos="0 0 -0.42">
          <joint name="knee_left" type="hinge" axis="0 1 0" range="-1.8 0.05"/>
          <geom name="left_knee_geom" type="sphere" size="0.052" material="joint_mat"/>
          <geom name="left_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.40" size="0.045" material="body_mat"/>

          <body name="left_foot" pos="0 0 -0.40">
            <joint name="ankle_left" type="hinge" axis="0 1 0" range="-0.7 0.7"/>
            <geom name="left_ankle_geom" type="sphere" size="0.045" material="joint_mat"/>
            <geom name="left_foot_geom" type="box" pos="0.08 0 -0.035" size="0.16 0.06 0.035" material="foot_mat"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="abdomen_y_motor" joint="abdomen_y" gear="80"/>
    <motor name="shoulder_right_motor" joint="shoulder_right" gear="45"/>
    <motor name="elbow_right_motor" joint="elbow_right" gear="35"/>
    <motor name="shoulder_left_motor" joint="shoulder_left" gear="45"/>
    <motor name="elbow_left_motor" joint="elbow_left" gear="35"/>
    <motor name="hip_right_motor" joint="hip_right" gear="85"/>
    <motor name="knee_right_motor" joint="knee_right" gear="85"/>
    <motor name="ankle_right_motor" joint="ankle_right" gear="55"/>
    <motor name="hip_left_motor" joint="hip_left" gear="85"/>
    <motor name="knee_left_motor" joint="knee_left" gear="85"/>
    <motor name="ankle_left_motor" joint="ankle_left" gear="55"/>
  </actuator>
</mujoco>
