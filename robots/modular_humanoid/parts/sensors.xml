<mujoco>
  <!-- Pelvis IMU: gyro, accelerometer, orientation, linear velocity, position -->
  <gyro name="pelvis_gyro" site="pelvis_imu"/>
  <accelerometer name="pelvis_accel" site="pelvis_imu"/>
  <velocimeter name="pelvis_linvel" site="pelvis_imu"/>
  <framequat name="pelvis_quat" objtype="site" objname="pelvis_imu"/>
  <framepos name="pelvis_pos" objtype="site" objname="pelvis_imu"/>
  <framelinvel name="pelvis_world_linvel" objtype="site" objname="pelvis_imu"/>
  <frameangvel name="pelvis_world_angvel" objtype="site" objname="pelvis_imu"/>

  <!-- Head IMU (useful for vision stabilization / gaze control) -->
  <gyro name="head_gyro" site="head_imu"/>
  <accelerometer name="head_accel" site="head_imu"/>
  <framequat name="head_quat" objtype="site" objname="head_imu"/>

  <!-- Right foot: 6-axis force/torque at ankle, sole touch, heel/toe contact -->
  <force name="right_ankle_force" site="right_ankle_force"/>
  <torque name="right_ankle_torque" site="right_ankle_force"/>
  <touch name="right_sole_touch" site="right_sole"/>
  <touch name="right_heel_touch" site="right_heel"/>
  <touch name="right_toe_touch" site="right_toe_tip"/>
  <framepos name="right_foot_pos" objtype="site" objname="right_sole"/>
  <framelinvel name="right_foot_linvel" objtype="site" objname="right_sole"/>

  <!-- Left foot: same suite -->
  <force name="left_ankle_force" site="left_ankle_force"/>
  <torque name="left_ankle_torque" site="left_ankle_force"/>
  <touch name="left_sole_touch" site="left_sole"/>
  <touch name="left_heel_touch" site="left_heel"/>
  <touch name="left_toe_touch" site="left_toe_tip"/>
  <framepos name="left_foot_pos" objtype="site" objname="left_sole"/>
  <framelinvel name="left_foot_linvel" objtype="site" objname="left_sole"/>
</mujoco>
