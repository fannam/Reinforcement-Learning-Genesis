<mujoco>
  <!-- Self-collision exclusions for non-adjacent body pairs that overlap or
       sit close enough to generate spurious contacts during normal motion.
       Parent-child contacts inside the kinematic tree are auto-filtered by
       MuJoCo, so we only enumerate "skip-a-link" or cross-chain pairs. -->

  <!-- Pelvis vs upper-leg (grandchild via hip yaw/roll dummies) -->
  <exclude body1="pelvis" body2="right_thigh"/>
  <exclude body1="pelvis" body2="left_thigh"/>

  <!-- Torso vs pelvis (grandchild via abdomen yaw/roll dummies) -->
  <exclude body1="pelvis" body2="torso"/>

  <!-- Torso vs upper-arms (grandchild via shoulder yaw/roll dummies) -->
  <exclude body1="torso" body2="right_upper_arm"/>
  <exclude body1="torso" body2="left_upper_arm"/>

  <!-- Torso vs head (grandchild via neck yaw) -->
  <exclude body1="torso" body2="head"/>

  <!-- Forearm vs upper-arm (grandchild via forearm_yaw dummy) -->
  <exclude body1="right_upper_arm" body2="right_forearm"/>
  <exclude body1="left_upper_arm" body2="left_forearm"/>

  <!-- Wrist/hand vs forearm (grandchild via wrist_yaw dummy) -->
  <exclude body1="right_forearm" body2="right_wrist"/>
  <exclude body1="left_forearm" body2="left_wrist"/>
  <exclude body1="right_forearm" body2="right_hand"/>
  <exclude body1="left_forearm" body2="left_hand"/>

  <!-- Shin vs thigh (grandchild via knee — actually direct, but the leg has
       hip dummies so be explicit) -->
  <exclude body1="right_thigh" body2="right_foot"/>
  <exclude body1="left_thigh" body2="left_foot"/>

  <!-- Foot vs shin (grandchild via ankle_roll dummy) -->
  <exclude body1="right_shin" body2="right_foot"/>
  <exclude body1="left_shin" body2="left_foot"/>

  <!-- Cross-chain pairs: legs swinging together, arms brushing torso/legs -->
  <exclude body1="right_thigh" body2="left_thigh"/>
  <exclude body1="right_shin" body2="left_shin"/>
  <exclude body1="right_foot" body2="left_foot"/>
  <exclude body1="right_toe" body2="left_toe"/>

  <!-- Hands brushing thighs / pelvis during arm swing -->
  <exclude body1="right_hand" body2="right_thigh"/>
  <exclude body1="left_hand" body2="left_thigh"/>
  <exclude body1="right_hand" body2="pelvis"/>
  <exclude body1="left_hand" body2="pelvis"/>
  <exclude body1="right_forearm" body2="right_thigh"/>
  <exclude body1="left_forearm" body2="left_thigh"/>

  <!-- Inside-leg / hand crossover -->
  <exclude body1="right_hand" body2="left_thigh"/>
  <exclude body1="left_hand" body2="right_thigh"/>
</mujoco>
