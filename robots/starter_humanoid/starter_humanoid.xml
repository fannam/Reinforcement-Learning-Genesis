<mujoco model="starter_humanoid">
  <compiler angle="radian" inertiafromgeom="true" autolimits="true"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <joint damping="1.0" armature="0.02" limited="true"/>
    <geom condim="3" contype="1" conaffinity="1" density="650" friction="1.0 0.1 0.1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <asset>
    <material name="body_blue" rgba="0.18 0.42 0.78 1"/>
    <material name="joint_dark" rgba="0.08 0.10 0.12 1"/>
    <material name="floor_mat" rgba="0.82 0.84 0.86 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -3 4" dir="0 1 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="5 5 0.05" material="floor_mat"/>

    <body name="pelvis" pos="0 0 1.15">
      <freejoint name="root"/>
      <geom name="pelvis_geom" type="capsule" fromto="-0.12 0 0 0.12 0 0" size="0.08" material="body_blue"/>

      <body name="torso_yaw" pos="0 0 0.12">
        <inertial pos="0 0 0" mass="0.02" diaginertia="0.0001 0.0001 0.0001"/>
        <joint name="abdomen_z" type="hinge" axis="0 0 1" range="-0.7 0.7"/>
        <body name="torso_pitch">
          <inertial pos="0 0 0" mass="0.02" diaginertia="0.0001 0.0001 0.0001"/>
          <joint name="abdomen_y" type="hinge" axis="0 1 0" range="-0.5 0.5"/>
          <body name="torso_roll">
            <joint name="abdomen_x" type="hinge" axis="1 0 0" range="-0.5 0.5"/>
            <geom name="torso_geom" type="capsule" fromto="0 0 -0.05 0 0 0.36" size="0.11" material="body_blue"/>
            <geom name="head_geom" type="sphere" pos="0 0 0.52" size="0.11" material="joint_dark"/>

            <body name="right_upper_arm_z" pos="0 -0.18 0.28">
              <inertial pos="0 0 0" mass="0.02" diaginertia="0.0001 0.0001 0.0001"/>
              <joint name="shoulder1_right" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
              <body name="right_upper_arm_y">
                <joint name="shoulder2_right" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
                <geom name="right_upper_arm_geom" type="capsule" fromto="0 0 0 0 -0.26 0" size="0.045" material="body_blue"/>
                <body name="right_forearm" pos="0 -0.26 0">
                  <joint name="elbow_right" type="hinge" axis="0 1 0" range="-1.7 0.1"/>
                  <geom name="right_forearm_geom" type="capsule" fromto="0 0 0 0 -0.24 0" size="0.04" material="joint_dark"/>
                </body>
              </body>
            </body>

            <body name="left_upper_arm_z" pos="0 0.18 0.28">
              <inertial pos="0 0 0" mass="0.02" diaginertia="0.0001 0.0001 0.0001"/>
              <joint name="shoulder1_left" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
              <body name="left_upper_arm_y">
                <joint name="shoulder2_left" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
                <geom name="left_upper_arm_geom" type="capsule" fromto="0 0 0 0 0.26 0" size="0.045" material="body_blue"/>
                <body name="left_forearm" pos="0 0.26 0">
                  <joint name="elbow_left" type="hinge" axis="0 1 0" range="-1.7 0.1"/>
                  <geom name="left_forearm_geom" type="capsule" fromto="0 0 0 0 0.24 0" size="0.04" material="joint_dark"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="abdomen_z_motor" joint="abdomen_z" gear="80"/>
    <motor name="abdomen_y_motor" joint="abdomen_y" gear="80"/>
    <motor name="abdomen_x_motor" joint="abdomen_x" gear="80"/>
    <motor name="shoulder1_right_motor" joint="shoulder1_right" gear="45"/>
    <motor name="shoulder2_right_motor" joint="shoulder2_right" gear="45"/>
    <motor name="elbow_right_motor" joint="elbow_right" gear="35"/>
    <motor name="shoulder1_left_motor" joint="shoulder1_left" gear="45"/>
    <motor name="shoulder2_left_motor" joint="shoulder2_left" gear="45"/>
    <motor name="elbow_left_motor" joint="elbow_left" gear="35"/>
  </actuator>
</mujoco>
