  <!--
  Khối <contact><exclude>: liệt kê các cặp body KHÔNG cần kiểm tra va chạm
  Mặc định MuJoCo kiểm tra mọi cặp geom có contype/conaffinity khớp,
  với humanoid nhiều khớp -> rất tốn. Loại bỏ self-collision giữa các bộ phận
  liền kề (ví dụ pelvis-thigh chạm nhau là bình thường khi co chân)
  để engine không sinh contact giả gây giật/mất ổn định
  -->
  <contact>
    <exclude body1="pelvis" body2="right_thigh" />
    <exclude body1="pelvis" body2="left_thigh" />
    <exclude body1="pelvis" body2="torso" />
    <exclude body1="torso" body2="right_upper_arm" />
    <exclude body1="torso" body2="left_upper_arm" />
    <exclude body1="torso" body2="head" />
    <exclude body1="right_upper_arm" body2="right_forearm" />
    <exclude body1="left_upper_arm" body2="left_forearm" />
    <exclude body1="right_forearm" body2="right_wrist" />
    <exclude body1="left_forearm" body2="left_wrist" />
    <exclude body1="right_forearm" body2="right_hand" />
    <exclude body1="left_forearm" body2="left_hand" />
    <exclude body1="right_thigh" body2="right_foot" />
    <exclude body1="left_thigh" body2="left_foot" />
    <exclude body1="right_shin" body2="right_foot" />
    <exclude body1="left_shin" body2="left_foot" />
    <exclude body1="right_thigh" body2="left_thigh" />
    <exclude body1="right_shin" body2="left_shin" />
    <exclude body1="right_foot" body2="left_foot" />
    <exclude body1="right_toe" body2="left_toe" />
    <exclude body1="right_hand" body2="right_thigh" />
    <exclude body1="left_hand" body2="left_thigh" />
    <exclude body1="right_hand" body2="pelvis" />
    <exclude body1="left_hand" body2="pelvis" />
    <exclude body1="right_forearm" body2="right_thigh" />
    <exclude body1="left_forearm" body2="left_thigh" />
    <exclude body1="right_hand" body2="left_thigh" />
    <exclude body1="left_hand" body2="right_thigh" />
  </contact>
  <!--
  Mỗi <position> là PD controller (kp, kv lấy từ default class tương ứng)
  ctrlrange phải khớp range của joint, nếu vượt sẽ bị clamp
  attribute class="abdomen|hip|knee|..." kế thừa kp/kv/forcerange đã định nghĩa ở <default>
  -> chỉ cần đổi gain ở 1 chỗ là đổi cho cả nhóm khớp
  -->
  <actuator>
    <position name="abdomen_yaw_motor" joint="abdomen_yaw" class="abdomen" ctrlrange="-0.65 0.65" />
    <position name="abdomen_roll_motor" joint="abdomen_roll" class="abdomen" ctrlrange="-0.45 0.45" />
    <position name="abdomen_pitch_motor" joint="abdomen_pitch" class="abdomen" ctrlrange="-0.55 0.55" />
    <position name="neck_yaw_motor" joint="neck_yaw" class="neck" ctrlrange="-0.9 0.9" />
    <position name="neck_pitch_motor" joint="neck_pitch" class="neck" ctrlrange="-0.55 0.55" />
    <position name="shoulder_yaw_right_motor" joint="shoulder_yaw_right" class="shoulder" ctrlrange="-1.2 1.2" />
    <position name="shoulder_roll_right_motor" joint="shoulder_roll_right" class="shoulder" ctrlrange="-1.1 0.6" />
    <position name="shoulder_pitch_right_motor" joint="shoulder_pitch_right" class="shoulder" ctrlrange="-1.9 1.2" />
    <position name="forearm_yaw_right_motor" joint="forearm_yaw_right" class="forearm" ctrlrange="-1.3 1.3" />
    <position name="elbow_pitch_right_motor" joint="elbow_pitch_right" class="elbow" ctrlrange="-1.8 0.05" />
    <position name="wrist_yaw_right_motor" joint="wrist_yaw_right" class="wrist" ctrlrange="-0.9 0.9" />
    <position name="wrist_pitch_right_motor" joint="wrist_pitch_right" class="wrist" ctrlrange="-0.8 0.8" />
    <position name="thumb_abduction_right_motor" joint="thumb_abduction_right" class="finger" ctrlrange="-0.55 0.65" />
    <position name="thumb_flexion_right_motor" joint="thumb_flexion_right" class="finger" ctrlrange="-0.15 1.1" />
    <position name="index_flexion_right_motor" joint="index_flexion_right" class="finger" ctrlrange="-0.1 1.25" />
    <position name="index_tip_right_motor" joint="index_tip_right" class="finger" ctrlrange="-0.1 1.0" />
    <position name="middle_flexion_right_motor" joint="middle_flexion_right" class="finger" ctrlrange="-0.1 1.25" />
    <position name="middle_tip_right_motor" joint="middle_tip_right" class="finger" ctrlrange="-0.1 1.0" />
    <position name="shoulder_yaw_left_motor" joint="shoulder_yaw_left" class="shoulder" ctrlrange="-1.2 1.2" />
    <position name="shoulder_roll_left_motor" joint="shoulder_roll_left" class="shoulder" ctrlrange="-0.6 1.1" />
    <position name="shoulder_pitch_left_motor" joint="shoulder_pitch_left" class="shoulder" ctrlrange="-1.9 1.2" />
    <position name="forearm_yaw_left_motor" joint="forearm_yaw_left" class="forearm" ctrlrange="-1.3 1.3" />
    <position name="elbow_pitch_left_motor" joint="elbow_pitch_left" class="elbow" ctrlrange="-1.8 0.05" />
    <position name="wrist_yaw_left_motor" joint="wrist_yaw_left" class="wrist" ctrlrange="-0.9 0.9" />
    <position name="wrist_pitch_left_motor" joint="wrist_pitch_left" class="wrist" ctrlrange="-0.8 0.8" />
    <position name="thumb_abduction_left_motor" joint="thumb_abduction_left" class="finger" ctrlrange="-0.65 0.55" />
    <position name="thumb_flexion_left_motor" joint="thumb_flexion_left" class="finger" ctrlrange="-0.15 1.1" />
    <position name="index_flexion_left_motor" joint="index_flexion_left" class="finger" ctrlrange="-0.1 1.25" />
    <position name="index_tip_left_motor" joint="index_tip_left" class="finger" ctrlrange="-0.1 1.0" />
    <position name="middle_flexion_left_motor" joint="middle_flexion_left" class="finger" ctrlrange="-0.1 1.25" />
    <position name="middle_tip_left_motor" joint="middle_tip_left" class="finger" ctrlrange="-0.1 1.0" />
    <position name="hip_yaw_right_motor" joint="hip_yaw_right" class="hip" ctrlrange="-0.8 0.8" />
    <position name="hip_roll_right_motor" joint="hip_roll_right" class="hip" ctrlrange="-0.55 0.45" />
    <position name="hip_pitch_right_motor" joint="hip_pitch_right" class="hip" ctrlrange="-1.25 1.0" />
    <position name="knee_pitch_right_motor" joint="knee_pitch_right" class="knee" ctrlrange="-1.9 0.05" />
    <position name="ankle_roll_right_motor" joint="ankle_roll_right" class="ankle" ctrlrange="-0.45 0.45" />
    <position name="ankle_pitch_right_motor" joint="ankle_pitch_right" class="ankle" ctrlrange="-0.75 0.75" />
    <position name="toe_pitch_right_motor" joint="toe_pitch_right" class="toe" ctrlrange="-0.35 0.55" />
    <position name="hip_yaw_left_motor" joint="hip_yaw_left" class="hip" ctrlrange="-0.8 0.8" />
    <position name="hip_roll_left_motor" joint="hip_roll_left" class="hip" ctrlrange="-0.45 0.55" />
    <position name="hip_pitch_left_motor" joint="hip_pitch_left" class="hip" ctrlrange="-1.25 1.0" />
    <position name="knee_pitch_left_motor" joint="knee_pitch_left" class="knee" ctrlrange="-1.9 0.05" />
    <position name="ankle_roll_left_motor" joint="ankle_roll_left" class="ankle" ctrlrange="-0.45 0.45" />
    <position name="ankle_pitch_left_motor" joint="ankle_pitch_left" class="ankle" ctrlrange="-0.75 0.75" />
    <position name="toe_pitch_left_motor" joint="toe_pitch_left" class="toe" ctrlrange="-0.35 0.55" />
  </actuator>
  <!--
  Cảm biến ảo gắn vào site (IMU) hoặc body
  pelvis IMU: gyro + accel + linvel + quat -> dữ liệu ước lượng tư thế thân
  head IMU: gyro + accel + quat cho góc nhìn
  ankle force/torque + sole/heel/toe touch -> phát hiện tiếp đất, tính ZMP, GRF
  framelinvel/framepos của bàn chân: hữu ích cho controller theo dõi swing leg
  -->
  <sensor>
    <gyro name="pelvis_gyro" site="pelvis_imu" />
    <accelerometer name="pelvis_accel" site="pelvis_imu" />
    <velocimeter name="pelvis_linvel" site="pelvis_imu" />
    <framequat name="pelvis_quat" objtype="site" objname="pelvis_imu" />
    <framepos name="pelvis_pos" objtype="site" objname="pelvis_imu" />
    <framelinvel name="pelvis_world_linvel" objtype="site" objname="pelvis_imu" />
    <frameangvel name="pelvis_world_angvel" objtype="site" objname="pelvis_imu" />
    <gyro name="head_gyro" site="head_imu" />
    <accelerometer name="head_accel" site="head_imu" />
    <framequat name="head_quat" objtype="site" objname="head_imu" />
    <force name="right_ankle_force" site="right_ankle_force" />
    <torque name="right_ankle_torque" site="right_ankle_force" />
    <touch name="right_sole_touch" site="right_sole" />
    <touch name="right_heel_touch" site="right_heel" />
    <touch name="right_toe_touch" site="right_toe_tip" />
    <framepos name="right_foot_pos" objtype="site" objname="right_sole" />
    <framelinvel name="right_foot_linvel" objtype="site" objname="right_sole" />
    <force name="left_ankle_force" site="left_ankle_force" />
    <torque name="left_ankle_torque" site="left_ankle_force" />
    <touch name="left_sole_touch" site="left_sole" />
    <touch name="left_heel_touch" site="left_heel" />
    <touch name="left_toe_touch" site="left_toe_tip" />
    <framepos name="left_foot_pos" objtype="site" objname="left_sole" />
    <framelinvel name="left_foot_linvel" objtype="site" objname="left_sole" />
  </sensor>
</mujoco>