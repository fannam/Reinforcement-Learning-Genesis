<mujoco model="modular_humanoid">
  <!--
  inertiafromgeom="true": tự tính khối lượng/quán tính từ geom (density + hình học)
  autolimits="true": tự bật limited khi joint có range, khỏi phải khai báo limited="true" thủ công
  -->
  <compiler angle="radian" inertiafromgeom="true" autolimits="true" />
  <!--
  integrator="RK4" (Runge-Kutta bậc 4) thay vì Euler mặc định
  chính xác hơn cho hệ phi tuyến nhiều khớp như humanoid, đổi lại đắt hơn ~4 lần/step
  timestep nhỏ (5ms) để ổn định khi có va chạm chân-sàn và contact lực lớn
  -->
  <option timestep="0.005" gravity="0 0 -9.81" integrator="RK4" />
  <default>
    <!--
    Default toàn cục: damping/armature cho mọi joint (giảm dao động số),
    density geom 650 kg/m^3 (xấp xỉ mô cơ thể người), friction trượt/xoay/lăn
    -->
    <joint damping="1.0" armature="0.02" limited="true" />
    <geom density="650" friction="1.0 0.1 0.1" />
    <site size="0.01" group="3" />
    <!--
    Mỗi default class định nghĩa gain (kp), damping (kv), forcerange cho actuator position
    nhóm theo bộ phận cơ thể: khớp lớn (hip/knee) cần kp & lực lớn,
    khớp nhỏ (finger/neck) kp & lực nhỏ
    actuator dưới chỉ cần đặt class="..." để kế thừa toàn bộ tham số
    -->
    <default class="abdomen">
      <position kp="200" kv="20" forcerange="-160 160" />
    </default>
    <default class="neck">
      <position kp="40" kv="4" forcerange="-25 25" />
    </default>
    <default class="shoulder">
      <position kp="160" kv="12" forcerange="-90 90" />
    </default>
    <default class="forearm">
      <position kp="80" kv="6" forcerange="-45 45" />
    </default>
    <default class="elbow">
      <position kp="120" kv="9" forcerange="-70 70" />
    </default>
    <default class="wrist">
      <position kp="50" kv="4" forcerange="-25 25" />
    </default>
    <default class="finger">
      <position kp="6" kv="0.6" forcerange="-5 5" />
    </default>
    <default class="hip">
      <position kp="280" kv="16" forcerange="-220 220" />
    </default>
    <default class="knee">
      <position kp="320" kv="18" forcerange="-260 260" />
    </default>
    <default class="ankle">
      <position kp="120" kv="8" forcerange="-90 90" />
    </default>
    <default class="toe">
      <position kp="40" kv="3" forcerange="-30 30" />
    </default>
  </default>
  <asset>
    <material name="pelvis_mat" rgba="0.16 0.26 0.38 1" />
    <material name="torso_mat" rgba="0.18 0.42 0.78 1" />
    <material name="limb_mat" rgba="0.24 0.50 0.76 1" />
    <material name="joint_mat" rgba="0.94 0.70 0.24 1" />
    <material name="hand_mat" rgba="0.62 0.66 0.68 1" />
    <material name="foot_mat" rgba="0.10 0.12 0.14 1" />
    <material name="sole_mat" rgba="0.04 0.05 0.06 1" />
    <material name="floor_mat" rgba="0.82 0.84 0.86 1" />
  </asset>
  <worldbody>
    <light name="key_light" pos="1 -3 4" dir="-0.2 0.6 -1" diffuse="0.8 0.8 0.8" />
    <camera name="front" pos="2.2 -3.0 1.4" xyaxes="0.80 0.60 0 -0.24 0.32 0.92" />
