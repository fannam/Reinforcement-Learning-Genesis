<mujoco model="basic_arm">
  <compiler angle="radian" inertiafromgeom="true" autolimits="true"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.8" armature="0.01" limited="true"/>
    <geom density="500" friction="1.0 0.1 0.1" rgba="0.2 0.45 0.8 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <asset>
    <material name="base_mat" rgba="0.12 0.14 0.16 1"/>
    <material name="link_mat" rgba="0.2 0.45 0.8 1"/>
    <material name="joint_mat" rgba="0.95 0.72 0.25 1"/>
    <material name="floor_mat" rgba="0.82 0.84 0.86 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="1 -3 4" dir="-0.2 0.6 -1" diffuse="0.8 0.8 0.8"/>
    <camera name="front" pos="1.8 -2.6 1.4" xyaxes="0.82 0.57 0 -0.22 0.31 0.93"/>
    <geom name="floor" type="plane" size="3 3 0.05" material="floor_mat"/>

    <body name="base" pos="0 0 0.12">
      <geom name="base_geom" type="box" size="0.18 0.18 0.12" material="base_mat"/>

      <body name="upper_arm" pos="0 0 0.16">
        <joint name="shoulder" type="hinge" axis="0 1 0" range="-1.4 1.4"/>
        <geom name="shoulder_geom" type="sphere" size="0.075" material="joint_mat"/>
        <geom name="upper_arm_geom" type="capsule" fromto="0 0 0 0 0 0.48" size="0.045" material="link_mat"/>

        <body name="forearm" pos="0 0 0.48">
          <joint name="elbow" type="hinge" axis="0 1 0" range="-1.6 0.2"/>
          <geom name="elbow_geom" type="sphere" size="0.065" material="joint_mat"/>
          <geom name="forearm_geom" type="capsule" fromto="0 0 0 0 0 0.38" size="0.04" material="link_mat"/>
          <geom name="tool_geom" type="box" pos="0 0 0.43" size="0.055 0.055 0.04" material="base_mat"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="60"/>
    <motor name="elbow_motor" joint="elbow" gear="40"/>
  </actuator>
</mujoco>
